# Puertos publicados en el anfitrión. El panel guarda aquí los cambios elegidos.
TECNM_FRONTEND_PORT=5173
TECNM_BACKEND_PORT=7001

# Nombres de contenedores. Enter conserva el nombre mostrado por el panel.
TECNM_FRONTEND_CONTAINER_NAME=TecNM_LoginControl_Frontend
TECNM_BACKEND_CONTAINER_NAME=TecNM_LoginControl_Backend

# Conexión PostgreSQL y sesión: configurar por separado en backend/.env.
