SESSION_GOOGLE_CLIENT_ID=
SESSION_GOOGLE_CLIENT_SECRET=
SESSION_MICROSOFT_CLIENT_ID=
SESSION_MICROSOFT_CLIENT_SECRET=
SESSION_MICROSOFT_TENANT_ID=
