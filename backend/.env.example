# Copiar a backend/.env y configurar PostgreSQL del anfitrión.
# Para Docker usar Host=host.docker.internal; para ejecución manual usar localhost.
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=tecnm_template;Username=tecnm_app;Password=REPLACE_LOCAL_PASSWORD"

# Sesión para ejecución manual. Generar la clave con openssl rand -base64 32.
Session__FrontendUrl=https://localhost:5100
Session__Issuer=
Session__Audience=
Session__SigningKey=
Session__Google__ClientId=
Session__Google__ClientSecret=
Session__Microsoft__ClientId=
Session__Microsoft__ClientSecret=
Session__Microsoft__TenantId=
